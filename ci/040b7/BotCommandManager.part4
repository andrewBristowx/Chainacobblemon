        variables = Map.of("server","Cobbleverse","discord","!discord");
        commands = List.of(
                new CommandDef("!server", List.of("!servidor","!minecraft"), true, "✨ ¿Quieres jugar con la comunidad de Chaina? Toda la información, requisitos y cómo entrar al servidor están en nuestro Discord 💜 Escribe {discord} en el chat.", 30, "everyone"),
                new CommandDef("!vincular", List.of("!link"), true, "🎮 Vincula tu cuenta de Twitch dentro del servidor para que podamos reconocer tu suscripción y darte tus beneficios de SUB CHAINA 💜", 30, "everyone"),
