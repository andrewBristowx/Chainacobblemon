+    private void validateBotPermissionsSafely() {
+        if (account == null) return;
+        try {
+            BotAccount current = account;
+            ValidatedUser validated = validateToken(current.accessToken());
+            BotAccount verified = verifyBotIdentity(current, validated, System.currentTimeMillis());
+            account = verified;
+            saveBotSafely();
+            if (!writePermissionReady) {
+                lastStatus = "EventSub puede seguir leyendo, pero falta user:write:chat. Pulsa Actualizar permisos para que el bot responda.";
+                System.out.println("[bot] Existing bot session needs reauthorization for user:write:chat.");
+            }
+        } catch (Exception error) {
+            System.err.println("[bot] Permission validation failed: " + safeError(error));
+        }
+    }
