diff -ruN alpha10src/src/client/java/com/andrewbristowx/chainacobblemon/client/twitch/ChainaTabDecoration.java alpha11work/src/client/java/com/andrewbristowx/chainacobblemon/client/twitch/ChainaTabDecoration.java
