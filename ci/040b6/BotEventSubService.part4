    private void handleChatNotification(JsonObject event) {
        String notice = string(event, "notice_type");
        String chatter = string(event, "chatter_user_login");
        boolean anonymous = bool(event, "chatter_is_anonymous");
        String actor = anonymous || chatter.isBlank() ? "Anónimo" : "@" + chatter;
        switch (notice) {
            case "sub" -> {
                JsonObject sub = object(event, "sub");
                subscriptionEvents.incrementAndGet();
                String tier = tier(string(sub, "sub_tier"));
                lastEvent = "SUB: " + actor + " · " + tier;
                System.out.println("[eventsub][SUB] " + actor + " subscribed " + tier + (bool(sub, "is_prime") ? " (Prime)" : ""));
            }
            case "resub" -> {
                JsonObject resub = object(event, "resub");
                subscriptionEvents.incrementAndGet();
                int months = integer(resub, "cumulative_months", 0);
                lastEvent = "RESUB: " + actor + " · " + tier(string(resub, "sub_tier"));
                System.out.println("[eventsub][RESUB] " + actor + " " + tier(string(resub, "sub_tier")) + " · " + months + " months" + (bool(resub, "is_gift") ? " · gifted" : ""));
            }
            case "sub_gift" -> {
                JsonObject gift = object(event, "sub_gift");
                giftEvents.incrementAndGet();
                String recipient = string(gift, "recipient_user_login");
                lastEvent = "SUB GIFT: " + actor + " -> @" + recipient;
                System.out.println("[eventsub][GIFT] " + actor + " gifted " + tier(string(gift, "sub_tier")) + " to @" + recipient);
            }
            case "community_sub_gift" -> {
                JsonObject gift = object(event, "community_sub_gift");
                giftEvents.incrementAndGet();
                int total = integer(gift, "total", 0);
                lastEvent = "COMMUNITY GIFT: " + actor + " -> " + total + " subs";
                System.out.println("[eventsub][COMMUNITY_GIFT] " + actor + " gifted " + total + " x " + tier(string(gift, "sub_tier")));
            }
            default -> {
                // Keep this alpha focused on the requested validation events.
            }
        }
    }

    private synchronized void loadBotSafely() {
        if (!Files.exists(BOT_STORE_PATH)) return;
        try {
            JsonObject envelope = object(Files.readString(BOT_STORE_PATH, StandardCharsets.UTF_8));
            byte[] iv = Base64.getDecoder().decode(string(envelope, "iv"));
            byte[] ciphertext = Base64.getDecoder().decode(string(envelope, "ciphertext"));
            Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
            cipher.init(Cipher.DECRYPT_MODE, new SecretKeySpec(storageKey, "AES"), new GCMParameterSpec(128, iv));
            cipher.updateAAD(BOT_STORE_AAD);
            byte[] plaintext = cipher.doFinal(ciphertext);
            try {
                JsonObject root = object(new String(plaintext, StandardCharsets.UTF_8));
                JsonObject json = object(root, "bot");
                if (json.size() == 0) return;
                BotAccount restored = new BotAccount(string(json, "user_id"), string(json, "login"), string(json, "access_token"),
                        string(json, "refresh_token"), longValue(json, "expires_at", 0), longValue(json, "last_validated", 0));
                if (!restored.accessToken().isBlank() && EXPECTED_BOT_LOGIN.equalsIgnoreCase(restored.login())) {
                    account = restored;
                    lastStatus = "Sesión cifrada de @ChainaMinecraftBot restaurada.";
                    System.out.println("[bot] Encrypted @ChainaMinecraftBot session restored.");
                }
            } finally {
                java.util.Arrays.fill(plaintext, (byte) 0);
            }
        } catch (Exception error) {
            System.err.println("[bot] Could not read encrypted bot store: " + safeError(error));
            try {
                Path backup = Path.of(BOT_STORE_PATH + ".unreadable-" + System.currentTimeMillis());
                Files.move(BOT_STORE_PATH, backup, StandardCopyOption.REPLACE_EXISTING);
            } catch (Exception ignored) { }
            account = null;
        }
    }

    private synchronized void saveBot() throws IOException {
        if (account == null) {
            Files.deleteIfExists(BOT_STORE_PATH);
            return;
        }
        BotAccount current = account;
        JsonObject json = new JsonObject();
        json.addProperty("user_id", current.userId());
        json.addProperty("login", current.login());
        json.addProperty("access_token", current.accessToken());
        json.addProperty("refresh_token", current.refreshToken());
        json.addProperty("expires_at", current.expiresAtMillis());
        json.addProperty("last_validated", current.lastValidatedMillis());
        JsonObject root = new JsonObject();
        root.addProperty("version", 1);
        root.add("bot", json);
        byte[] plaintext = GSON.toJson(root).getBytes(StandardCharsets.UTF_8);
        byte[] iv = new byte[12];
        SECURE_RANDOM.nextBytes(iv);
        try {
            Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
            cipher.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(storageKey, "AES"), new GCMParameterSpec(128, iv));
            cipher.updateAAD(BOT_STORE_AAD);
            byte[] ciphertext = cipher.doFinal(plaintext);
            JsonObject envelope = new JsonObject();
            envelope.addProperty("version", 1);
            envelope.addProperty("iv", Base64.getEncoder().encodeToString(iv));
            envelope.addProperty("ciphertext", Base64.getEncoder().encodeToString(ciphertext));
            Path temp = Path.of(BOT_STORE_PATH + ".tmp");
            Files.writeString(temp, GSON.toJson(envelope), StandardCharsets.UTF_8);
            restrictOwnerOnly(temp);
            try { Files.move(temp, BOT_STORE_PATH, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE); }
            catch (java.nio.file.AtomicMoveNotSupportedException unsupported) { Files.move(temp, BOT_STORE_PATH, StandardCopyOption.REPLACE_EXISTING); }
            restrictOwnerOnly(BOT_STORE_PATH);
        } catch (IOException io) {
            throw io;
        } catch (Exception error) {
            throw new IOException("Could not encrypt bot authorization store", error);
        } finally {
            java.util.Arrays.fill(plaintext, (byte) 0);
        }
    }

    private void saveBotSafely() {
        try { saveBot(); }
        catch (Exception error) { System.err.println("[bot] Could not persist encrypted bot session: " + safeError(error)); }
    }

    private void revokeToken(String accessToken) throws Exception {
        if (accessToken == null || accessToken.isBlank()) return;
        String form = "client_id=" + enc(clientIdSupplier.get()) + "&token=" + enc(accessToken);
        postForm("https://id.twitch.tv/oauth2/revoke", form);
    }

    private HttpResult postForm(String url, String form) throws Exception {
        HttpRequest request = HttpRequest.newBuilder(URI.create(url)).timeout(Duration.ofSeconds(15))
                .header("Content-Type", "application/x-www-form-urlencoded")
                .POST(HttpRequest.BodyPublishers.ofString(form, StandardCharsets.UTF_8)).build();
        HttpResponse<String> response = http.send(request, HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
        return new HttpResult(response.statusCode(), response.body());
    }

    private static void restrictOwnerOnly(Path path) {
        try { Files.setPosixFilePermissions(path, EnumSet.of(PosixFilePermission.OWNER_READ, PosixFilePermission.OWNER_WRITE)); }
        catch (UnsupportedOperationException | IOException ignored) { }
    }

    private static boolean method(HttpExchange exchange, String expected) throws IOException {
        if (expected.equalsIgnoreCase(exchange.getRequestMethod())) return true;
        exchange.getResponseHeaders().set("Allow", expected);
        exchange.sendResponseHeaders(405, -1);
        exchange.close();
        return false;
    }

    private static void sendHtml(HttpExchange exchange, int status, String html) throws IOException {
