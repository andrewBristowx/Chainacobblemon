+    private void observeChatRoles(JsonObject event) {
+        String userId = string(event, "chatter_user_id");
+        if (userId.isBlank()) return;
+        String login = string(event, "chatter_user_login").toLowerCase(Locale.ROOT);
+        boolean vip = false;
+        boolean moderator = false;
+        JsonArray badges = event != null && event.has("badges") && event.get("badges").isJsonArray()
+                ? event.getAsJsonArray("badges") : new JsonArray();
+        for (JsonElement element : badges) {
+            if (!element.isJsonObject()) continue;
+            String setId = string(element.getAsJsonObject(), "set_id").toLowerCase(Locale.ROOT);
+            if ("vip".equals(setId)) vip = true;
+            if ("moderator".equals(setId) || "broadcaster".equals(setId)) moderator = true;
+        }
+
+        long now = System.currentTimeMillis() / 1000L;
+        RoleObservation previous = roleObservations.get(userId);
+        // Avoid growing this store with every normal chatter. We only track role holders and
+        // users whose previously-observed role needs to be explicitly cleared.
+        if (!vip && !moderator && previous == null) return;
+        RoleObservation next = new RoleObservation(vip, moderator, now, login);
+        roleObservations.put(userId, next);
+        if (previous == null || previous.vip() != vip || previous.moderator() != moderator) {
+            System.out.println("[eventsub][ROLE] @" + (login.isBlank() ? userId : login)
+                    + " -> VIP=" + vip + " MOD=" + moderator);
+            saveRoleObservationsSafely();
+        }
+    }
+
+    RoleObservation roleFor(String twitchUserId) {
+        if (twitchUserId == null || twitchUserId.isBlank()) return RoleObservation.unknown();
+        RoleObservation value = roleObservations.get(twitchUserId);
+        if (value == null) return RoleObservation.unknown();
+        long now = System.currentTimeMillis() / 1000L;
+        if (value.observedAtEpochSeconds() <= 0L || now - value.observedAtEpochSeconds() > ROLE_OBSERVATION_TTL_SECONDS) {
+            roleObservations.remove(twitchUserId, value);
+            return RoleObservation.unknown();
+        }
+        return value;
+    }
+
