+    private void loadRoleObservationsSafely() {
+        roleObservations.clear();
+        if (!Files.isRegularFile(ROLE_STORE_PATH)) return;
+        try {
+            JsonObject root = object(Files.readString(ROLE_STORE_PATH, StandardCharsets.UTF_8));
+            JsonArray entries = root.has("roles") && root.get("roles").isJsonArray() ? root.getAsJsonArray("roles") : new JsonArray();
+            long now = System.currentTimeMillis() / 1000L;
+            for (JsonElement element : entries) {
+                if (!element.isJsonObject()) continue;
+                JsonObject row = element.getAsJsonObject();
+                String userId = string(row, "twitch_user_id");
+                if (userId.isBlank()) continue;
+                long observedAt = longValue(row, "observed_at", 0L);
+                if (observedAt <= 0L || now - observedAt > ROLE_OBSERVATION_TTL_SECONDS) continue;
+                roleObservations.put(userId, new RoleObservation(
+                        bool(row, "vip"), bool(row, "moderator"), observedAt, string(row, "twitch_login")));
+            }
+            if (!roleObservations.isEmpty()) {
+                System.out.println("[bot-role] Restored " + roleObservations.size() + " recent VIP/MOD observation(s).");
+            }
+        } catch (Exception error) {
+            System.err.println("[bot-role] Could not load role observations: " + safeError(error));
+            roleObservations.clear();
+        }
+    }
