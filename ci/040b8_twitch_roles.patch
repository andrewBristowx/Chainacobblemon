+
+    private void saveRoleObservations() throws IOException {
+        long now = System.currentTimeMillis() / 1000L;
+        roleObservations.entrySet().removeIf(entry -> now - entry.getValue().observedAtEpochSeconds() > ROLE_OBSERVATION_TTL_SECONDS);
+        JsonObject root = new JsonObject();
+        root.addProperty("version", 1);
+        root.addProperty("ttl_hours", ROLE_OBSERVATION_TTL_SECONDS / 3600L);
+        JsonArray rows = new JsonArray();
+        roleObservations.forEach((userId, value) -> {
+            JsonObject row = new JsonObject();
+            row.addProperty("twitch_user_id", userId);
+            row.addProperty("twitch_login", value.login());
+            row.addProperty("vip", value.vip());
+            row.addProperty("moderator", value.moderator());
+            row.addProperty("observed_at", value.observedAtEpochSeconds());
+            rows.add(row);
+        });
+        root.add("roles", rows);
+        Path temp = Path.of(ROLE_STORE_PATH + ".tmp");
+        Files.writeString(temp, GSON.toJson(root), StandardCharsets.UTF_8);
+        try { Files.move(temp, ROLE_STORE_PATH, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE); }
+        catch (java.nio.file.AtomicMoveNotSupportedException unsupported) { Files.move(temp, ROLE_STORE_PATH, StandardCopyOption.REPLACE_EXISTING); }
+    }
+
