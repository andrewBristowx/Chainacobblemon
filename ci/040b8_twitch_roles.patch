+        if (!first.known() || !first.vip() || first.moderator()) throw new IllegalStateException("VIP role observation failed");
+
+        JsonArray modBadges = new JsonArray();
+        JsonObject mod = new JsonObject(); mod.addProperty("set_id", "moderator"); modBadges.add(mod);
+        event.add("badges", modBadges);
+        observeChatRoles(event);
+        RoleObservation second = roleFor("role-test-user");
+        if (!second.known() || second.vip() || !second.moderator()) throw new IllegalStateException("MOD role observation failed");
+
+        event.add("badges", new JsonArray());
+        observeChatRoles(event);
+        RoleObservation cleared = roleFor("role-test-user");
+        if (!cleared.known() || cleared.vip() || cleared.moderator()) throw new IllegalStateException("Role revocation observation failed");
+        saveRoleObservations();
+        if (!Files.isRegularFile(ROLE_STORE_PATH)) throw new IllegalStateException("Role observation store was not written");
+        System.out.println("CHAINABRIDGE_ROLE_BADGE_SELF_TEST_OK");
+    }
